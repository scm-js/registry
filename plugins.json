{
  "name": "scm-js plugins",
  "description": "The plugins published by the scm-js project.",
  "discover": {
    "org": "scm-js",
    "prefix": "plugin-",
    "topics": [
      "scmjs",
      "plugin"
    ]
  },
  "exclude": [
    "scm-js/plugin-ai"
  ],
  "plugins": [
    {
      "repo": "scm-js/plugin-scm-scx",
      "tags": [
        "maps",
        "search",
        "download"
      ],
      "default": true,
      "reviewed": "1.0.0"
    },
    {
      "repo": "scm-js/plugin-image-to-terrain",
      "tags": [
        "terrain",
        "import",
        "image"
      ],
      "default": true,
      "reviewed": "1.0.0"
    },
    {
      "repo": "scm-js/plugin-repair",
      "tags": [
        "repair",
        "protection",
        "sections"
      ],
      "default": true,
      "reviewed": "1.0.0"
    },
    {
      "repo": "scm-js/plugin-paint",
      "tags": [
        "terrain",
        "units",
        "drawing",
        "tools"
      ],
      "default": true,
      "reviewed": "1.0.0"
    },
    {
      "repo": "scm-js/plugin-section-explorer",
      "tags": [
        "sections",
        "hex",
        "file format"
      ],
      "default": true,
      "reviewed": "1.0.0"
    },
    {
      "repo": "scm-js/plugin-walkability",
      "tags": [
        "analysis",
        "melee",
        "overlay"
      ],
      "default": true,
      "reviewed": "1.1.0"
    },
    {
      "repo": "scm-js/plugin-melee-wizard",
      "tags": [
        "melee",
        "start locations",
        "bases"
      ],
      "default": true,
      "reviewed": "1.0.0"
    },
    {
      "repo": "scm-js/plugin-hello-world",
      "tags": [
        "example",
        "template"
      ],
      "reviewed": "1.0.0"
    }
  ]
}
